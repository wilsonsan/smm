generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  GOOGLE_BUSINESS
}

enum PublishAttemptStatus {
  PENDING
  SKIPPED_DEV_PLACEHOLDER
  SUCCEEDED
  FAILED
}

enum ConnectedAccountStatus {
  CONNECTED
  NEEDS_RECONNECT
  EXPIRED
  INVALID
  MISSING_SCOPES
  DISCONNECTED
  ERROR
}

enum NotificationType {
  TOKEN_EXPIRED
  TOKEN_INVALID
  MISSING_SCOPE
  PUBLISH_FAILED
  WORKER_ERROR
  INFO
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum AdminUserRole {
  ADMIN
  CREATOR
}

enum MediaVariantType {
  ORIGINAL
  FACEBOOK_FEED
  GOOGLE_BUSINESS_SAFE
  INSTAGRAM_FEED_PLACEHOLDER
}

model AdminUser {
  id             String         @id @default(cuid())
  firstName      String?
  lastName       String?
  username       String         @unique
  email          String         @unique
  passwordHash   String
  role           AdminUserRole  @default(ADMIN)
  displayName    String?
  mfaEnabled     Boolean        @default(false)
  mfaSecretEncrypted String?    @db.LongText
  mfaVerifiedAt  DateTime?
  mfaLastUsedAt  DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       AdminSession[]
  pendingMfaSessions PendingMfaSession[]
  mfaRecoveryCodes MfaRecoveryCode[]
  uploadedMedia  MediaAsset[]
  createdPosts   SocialPost[]   @relation("CreatedPosts")
  updatedPosts   SocialPost[]   @relation("UpdatedPosts")
  auditLogs      AuditLog[]
  notificationsRead Notification[] @relation("NotificationReadBy")
}

model AdminSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  adminUserId    String
  expiresAt      DateTime
  lastAccessedAt DateTime  @default(now())
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model PendingMfaSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  adminUserId    String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id           String    @id @default(cuid())
  adminUserId  String
  codeHash     String
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, usedAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id                   String         @id @default(cuid())
  contentHash          String?        @db.VarChar(64)
  originalFilename     String
  mimeType             String
  sizeBytes            BigInt
  width                Int
  height               Int
  storagePath          String
  createdByAdminUserId String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  createdByAdminUser   AdminUser      @relation(fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  variants             MediaVariant[]
  posts                SocialPost[]
  attachedToPosts      SocialPostMediaAsset[]

  @@index([createdByAdminUserId])
  @@index([contentHash])
}

model MediaVariant {
  id          String           @id @default(cuid())
  mediaAssetId String
  variantType MediaVariantType
  mimeType    String
  sizeBytes   BigInt
  width       Int
  height      Int
  storagePath String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  mediaAsset  MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, variantType])
  @@index([mediaAssetId])
  @@index([variantType])
}

model SocialPost {
  id                   String               @id @default(cuid())
  internalTitle        String
  caption              String               @db.Text
  descriptionMain      String               @db.Text
  descriptionFacebook  String?              @db.Text
  descriptionInstagram String?              @db.Text
  instagramFirstComment String?             @db.Text
  descriptionGoogleBusiness String?         @db.Text
  projectType          String?
  tileType             String?
  roomType             String?
  city                 String?
  hashtags             Json?
  includeHashtagsInGoogle Boolean          @default(false)
  status               SocialPostStatus     @default(DRAFT)
  scheduledAt          DateTime?
  publishedAt          DateTime?
  failureReason        String?              @db.Text
  mediaAssetId         String?
  createdByAdminUserId String
  updatedByAdminUserId String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  mediaAsset           MediaAsset?          @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdByAdminUser   AdminUser            @relation("CreatedPosts", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  updatedByAdminUser   AdminUser            @relation("UpdatedPosts", fields: [updatedByAdminUserId], references: [id], onDelete: Restrict)
  platforms            SocialPostPlatform[]
  publishAttempts      PublishAttempt[]
  attachedMedia        SocialPostMediaAsset[]

  @@index([status, scheduledAt])
  @@index([mediaAssetId])
  @@index([createdByAdminUserId])
  @@index([updatedByAdminUserId])
}

model SocialPostMediaAsset {
  socialPostId String
  mediaAssetId String
  position     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([socialPostId, mediaAssetId])
  @@unique([socialPostId, position])
  @@index([mediaAssetId])
}

model SocialPostPlatform {
  id            String               @id @default(cuid())
  socialPostId  String
  platform      SocialPlatform
  status        SocialPostStatus     @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  platformPostId String?
  platformPostUrl String?            @db.Text
  lastError     String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  socialPost    SocialPost           @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  publishAttempts PublishAttempt[]

  @@unique([socialPostId, platform])
  @@index([platform, status, scheduledAt])
}

model PublishAttempt {
  id                   String               @id @default(cuid())
  socialPostId         String
  socialPostPlatformId String
  platform             SocialPlatform
  status               PublishAttemptStatus
  requestSummary       Json?
  responseSummary      Json?
  errorCode            String?
  errorMessage         String?              @db.Text
  platformPostId       String?
  platformPostUrl      String?              @db.Text
  startedAt            DateTime             @default(now())
  finishedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  socialPost           SocialPost           @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  socialPostPlatform   SocialPostPlatform   @relation(fields: [socialPostPlatformId], references: [id], onDelete: Cascade)

  @@index([socialPostId, startedAt])
  @@index([socialPostPlatformId, startedAt])
  @@index([platform, status, startedAt])
}

model AuditLog {
  id               String    @id @default(cuid())
  actorAdminUserId String?
  action           String
  targetType       String?
  targetId         String?
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  actorAdminUser   AdminUser? @relation(fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([actorAdminUserId])
  @@index([action, createdAt])
}

model ConnectedAccount {
  id                   String                 @id @default(cuid())
  platform             SocialPlatform         @unique
  accountName          String
  accountId            String?
  pageId               String?
  pageName             String?
  accessTokenEncrypted String?                @db.LongText
  refreshTokenEncrypted String?               @db.LongText
  tokenExpiresAt       DateTime?
  scopes               Json?
  status               ConnectedAccountStatus @default(DISCONNECTED)
  lastTestedAt         DateTime?
  lastSuccessfulTestAt DateTime?
  lastFailedTestAt     DateTime?
  lastError            String?                @db.Text
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([platform, status])
}

model Notification {
  id                String               @id @default(cuid())
  type              NotificationType
  provider          SocialPlatform?
  severity          NotificationSeverity @default(INFO)
  title             String
  message           String               @db.Text
  actionUrl         String?              @db.Text
  status            NotificationStatus   @default(UNREAD)
  readAt            DateTime?
  dismissedAt       DateTime?
  readByAdminUserId String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  readByAdminUser   AdminUser?           @relation("NotificationReadBy", fields: [readByAdminUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([provider, type, status])
  @@index([readByAdminUserId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  bucketKey String   @db.VarChar(191)
  scope     String   @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([bucketKey, createdAt])
  @@index([expiresAt])
}

model RateLimitLease {
  id        String   @id @default(cuid())
  bucketKey String   @db.VarChar(191)
  ownerKey  String   @unique @db.VarChar(191)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([bucketKey, expiresAt])
  @@index([expiresAt])
}
